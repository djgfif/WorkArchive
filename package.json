{
  "name": "work-archive",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "node scripts/dev/ensure-node-version.mjs",
    "predev": "npm run check:runtime",
    "dev": "concurrently -k --success=all -n web,api -c blue,green \"npm run dev --workspace @work-archive/web\" \"npm run dev --workspace @work-archive/api\"",
    "predev:start": "npm run check:runtime",
    "dev:start": "node scripts/dev/start-dev.mjs",
    "predev:start:host": "npm run check:runtime",
    "dev:start:host": "node scripts/dev/start-dev.mjs host",
    "dev:stop": "node scripts/dev/stop-dev.mjs",
    "predev:web": "npm run check:runtime",
    "dev:web": "npm run dev --workspace @work-archive/web",
    "predev:api": "npm run check:runtime",
    "dev:api": "npm run dev --workspace @work-archive/api",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose stop postgres",
    "storage:export-legacy-origin": "node scripts/dev/export-legacy-origin.mjs",
    "db:migrate:dev": "npm run prisma:migrate:dev --workspace @work-archive/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @work-archive/api",
    "db:seed": "npm run prisma:seed --workspace @work-archive/api",
    "compose:up": "docker compose --env-file .env.compose up --build",
    "compose:down": "docker compose --env-file .env.compose down",
    "prelint": "npm run check:runtime",
    "lint": "npm run lint --workspaces --if-present",
    "pretypecheck": "npm run check:runtime",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run check:runtime",
    "test": "npm run qa:web-bundle-budget:self-test && npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @work-archive/api",
    "test:e2e:web": "playwright test",
    "test:integration": "npm run test:integration --workspace @work-archive/api",
    "check:web-boundaries": "node scripts/check-web-feature-boundaries.mjs",
    "check:web-i18n": "node scripts/check-web-i18n-hardcoding.mjs",
    "check:web-i18n-resources": "node scripts/check-web-i18n-resources.mjs",
    "check:web-i18n-packs": "node scripts/check-web-i18n-translation-packs.mjs",
    "check:web-import-cycles": "node scripts/check-web-import-cycles.mjs",
    "i18n:export-work-pack": "node scripts/export-web-i18n-work-pack.mjs",
    "i18n:summary": "node scripts/export-web-i18n-work-pack.mjs --summary",
    "check:docs-links": "node scripts/check-doc-links.mjs",
    "security:secrets": "node scripts/security/secret-leak-check.mjs",
    "security:install-hooks": "node scripts/security/install-git-hooks.mjs",
    "security:public": "scripts/security/public-readiness-check.sh",
    "security:audit": "npm audit",
    "security:audit:prod": "npm audit --omit=dev",
    "security:audit:prod:high": "npm audit --omit=dev --audit-level=high",
    "security:scan:fs": "scripts/security/release-trivy-scan.sh fs",
    "security:scan:images": "scripts/security/release-trivy-scan.sh images",
    "security:scan:release": "scripts/security/release-trivy-scan.sh all",
    "qa:gate1:local": "scripts/qa/gate1-evidence-local.sh",
    "qa:gate1:evidence": "node scripts/qa/validate-gate1-evidence.mjs",
    "qa:gate1:evidence:self-test": "node scripts/qa/validate-gate1-evidence.self-test.mjs",
    "qa:gate1:missing": "node scripts/qa/gate1-missing-evidence-report.mjs",
    "qa:web-bundle-budget": "node scripts/qa/validate-web-bundle-budget.mjs",
    "qa:web-bundle-budget:self-test": "node scripts/qa/validate-web-bundle-budget.self-test.mjs",
    "qa:commercial:repo": "scripts/qa/commercial-repo-gates.sh",
    "qa:migrations": "node scripts/qa/validate-prisma-migrations.mjs",
    "qa:bola-matrix": "node scripts/qa/validate-bola-matrix.mjs",
    "qa:api-auth-surface": "node scripts/qa/validate-api-auth-surface.mjs",
    "qa:api-input-contracts": "node scripts/qa/validate-api-input-contracts.mjs",
    "qa:api-cache-policy": "node scripts/qa/validate-api-cache-policy.mjs",
    "qa:api-security-headers": "node scripts/qa/validate-api-security-headers.mjs",
    "qa:api-error-policy": "node scripts/qa/validate-api-error-policy.mjs",
    "qa:csrf-policy": "node scripts/qa/validate-csrf-policy.mjs",
    "qa:image-proxy-policy": "node scripts/qa/validate-image-proxy-policy.mjs",
    "qa:deploy-scripts": "node scripts/qa/validate-deploy-scripts.mjs",
    "qa:owner-invariants": "node scripts/qa/validate-owner-invariants.mjs",
    "qa:compose-hardening": "node scripts/qa/validate-compose-hardening.mjs",
    "qa:auth-session-policy": "node scripts/qa/validate-auth-session-policy.mjs",
    "qa:oauth-policy": "node scripts/qa/validate-oauth-policy.mjs",
    "qa:log-redaction-policy": "node scripts/qa/validate-log-redaction-policy.mjs",
    "qa:operator-safety": "node scripts/qa/validate-operator-safety.mjs",
    "qa:backup-restore-policy": "node scripts/qa/validate-backup-restore-policy.mjs",
    "qa:secure-sdlc-policy": "node scripts/qa/validate-secure-sdlc-policy.mjs",
    "qa:public-boundary": "node scripts/qa/validate-public-permission-boundary.mjs",
    "qa:retention-policy": "node scripts/qa/validate-retention-policy.mjs",
    "qa:user-data-rights-policy": "node scripts/qa/validate-user-data-rights-policy.mjs",
    "qa:user-data-rights-smoke": "node scripts/qa/user-data-rights-smoke.mjs",
    "qa:account-deletion-rehearsal": "node scripts/qa/account-deletion-rehearsal.mjs",
    "qa:alerts": "node scripts/qa/validate-prometheus-alerts.mjs",
    "qa:dashboards": "node scripts/qa/validate-grafana-dashboard.mjs",
    "qa:slo": "node scripts/qa/validate-prometheus-slo-rules.mjs",
    "qa:monitoring": "node scripts/qa/monitoring-evidence.mjs",
    "qa:docker-runtime": "node scripts/qa/docker-runtime-preflight.mjs",
    "qa:docker-runtime:self-test": "node scripts/qa/docker-runtime-preflight.self-test.mjs",
    "qa:import-search": "node scripts/qa/import-search-qa.mjs",
    "qa:performance-smoke": "node scripts/qa/performance-smoke.mjs",
    "qa:sync-architecture": "node scripts/qa/validate-sync-architecture.mjs",
    "qa:sync-load": "node scripts/qa/sync-load-smoke.mjs",
    "ops:backup": "scripts/deploy/prod-backup.sh",
    "ops:backup:verify": "scripts/deploy/prod-backup-verify.sh",
    "ops:healthcheck": "scripts/deploy/prod-healthcheck.sh",
    "ops:logs": "scripts/deploy/prod-logs.sh",
    "ops:restore-drill": "scripts/deploy/prod-restore-drill.sh",
    "api:generate": "orval --config orval.config.ts",
    "prebuild": "npm run check:runtime",
    "build": "npm run build --workspace @work-archive/shared-types && npm run build --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "postinstall": "npm run prisma:generate --workspace @work-archive/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "fast-check": "^4.8.0",
    "msw": "^2.14.6",
    "orval": "^8.17.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    },
    "js-yaml": "5.1.0"
  }
}
