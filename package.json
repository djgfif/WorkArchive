{
  "name": "work-archive",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k --success=all -n web,api -c blue,green \"npm run dev --workspace @work-archive/web\" \"npm run dev --workspace @work-archive/api\"",
    "dev:start": "node scripts/dev/start-dev.mjs",
    "dev:start:host": "node scripts/dev/start-dev.mjs host",
    "dev:stop": "node scripts/dev/stop-dev.mjs",
    "dev:web": "npm run dev --workspace @work-archive/web",
    "dev:api": "npm run dev --workspace @work-archive/api",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose stop postgres",
    "storage:export-legacy-origin": "node scripts/dev/export-legacy-origin.mjs",
    "db:migrate:dev": "npm run prisma:migrate:dev --workspace @work-archive/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @work-archive/api",
    "db:seed": "npm run prisma:seed --workspace @work-archive/api",
    "compose:up": "docker compose --env-file .env.compose up --build",
    "compose:down": "docker compose --env-file .env.compose down",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @work-archive/api",
    "test:e2e:web": "playwright test",
    "test:integration": "npm run test:integration --workspace @work-archive/api",
    "check:web-boundaries": "node scripts/check-web-feature-boundaries.mjs",
    "check:web-import-cycles": "node scripts/check-web-import-cycles.mjs",
    "check:docs-links": "node scripts/check-doc-links.mjs",
    "security:secrets": "node scripts/security/secret-leak-check.mjs",
    "security:install-hooks": "node scripts/security/install-git-hooks.mjs",
    "security:public": "scripts/security/public-readiness-check.sh",
    "security:audit": "npm audit",
    "security:audit:prod": "npm audit --omit=dev",
    "security:scan:fs": "scripts/security/release-trivy-scan.sh fs",
    "security:scan:images": "scripts/security/release-trivy-scan.sh images",
    "security:scan:release": "scripts/security/release-trivy-scan.sh all",
    "qa:gate1:local": "scripts/qa/gate1-evidence-local.sh",
    "qa:import-search": "node scripts/qa/import-search-qa.mjs",
    "qa:sync-load": "node scripts/qa/sync-load-smoke.mjs",
    "api:generate": "orval --config orval.config.ts",
    "build": "npm run build --workspace @work-archive/shared-types && npm run build --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "postinstall": "npm run prisma:generate --workspace @work-archive/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.1",
    "fast-check": "^4.8.0",
    "msw": "^2.14.6",
    "orval": "^8.15.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  }
}
