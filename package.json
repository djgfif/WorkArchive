{
  "name": "work-archive",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev --workspace @work-archive/web\" \"npm run dev --workspace @work-archive/api\"",
    "dev:web": "npm run dev --workspace @work-archive/web",
    "dev:api": "npm run dev --workspace @work-archive/api",
    "dev:db": "docker compose up -d",
    "dev:db:down": "docker compose down",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "postinstall": "npm run prisma:generate --workspace @work-archive/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
