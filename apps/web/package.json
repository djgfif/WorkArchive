{
  "name": "@work-archive/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/qa/validate-web-bundle-budget.mjs",
    "build:sites": "node scripts/clean-sites-dist.mjs && vite build --mode sites && node ../../scripts/qa/validate-web-bundle-budget.mjs dist/client/assets && node scripts/prepare-sites-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --maxWorkers=1 && node --test sites/worker.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@mantine/core": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.3.1",
    "@tanstack/react-query": "^5.102.8",
    "@work-archive/shared-types": "0.1.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.2.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@work-archive/eslint-config": "0.1.0",
    "@work-archive/tsconfig": "0.1.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^29.1.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
