# Local host-based web development.
# Copy this file to `apps/web/.env` if you want to override the default API URL.
# Use `localhost` for OAuth callback consistency.

VITE_API_BASE_URL="http://localhost:3000/api"

# Optional feature flags. Defaults:
# - tier boards: enabled
# - public share/community feed: disabled
# - PWA install prompts: disabled
# - diagnostics UI: disabled
VITE_FEATURE_TIER_BOARDS="true"
VITE_FEATURE_PUBLIC_SHARE="false"
VITE_FEATURE_PWA_INSTALL="false"
VITE_FEATURE_DIAGNOSTICS="false"

# Quick Add provider keys live on the API side or in authenticated account settings.
