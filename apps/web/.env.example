# Local host-based web development.
# Copy this file to `apps/web/.env` if you want to override the default API URL.
# Use `127.0.0.1` (not `localhost`) for host-based local dev to match API CORS.

VITE_API_BASE_URL="http://127.0.0.1:3000/api"

