# Local host-based API development.
# Copy this file to `apps/api/.env` when you want an explicit local API env file.
# Use `127.0.0.1` for host-based local dev (not `localhost`).
# For Docker Compose, use root `.env.example` instead.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/work_archive?schema=public&connect_timeout=5"
HOST="0.0.0.0"
PORT=3000
PRISMA_CONNECT_TIMEOUT_MS=10000
SWAGGER_ENABLED=true
# Single origin for host-based local dev — aligns with web's http://127.0.0.1:53173
CORS_ORIGIN="http://127.0.0.1:53173"
WEB_BASE_URL="http://127.0.0.1:53173"
PUBLIC_WEB_BASE_URL="http://127.0.0.1:53173"
PASSWORD_RESET_DEV_LINKS_ENABLED=true

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="change-me-external-api-key-encryption-secret"

# Optional server-scoped import providers for Quick Add.
TMDB_API_READ_TOKEN=""
TMDB_API_KEY=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
KAKAO_REST_API_KEY=""
KOBIS_API_KEY=""

# User-scoped Aladin TTBKey is stored per account through /account/settings.

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
