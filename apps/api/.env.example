# Local host-based API development.
# Copy this file to `apps/api/.env` when you want an explicit local API env file.
# Use `127.0.0.1` for host-based local dev (not `localhost`).
# For Docker Compose, use root `.env.example` instead.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/work_archive?schema=public&connect_timeout=5"
HOST="0.0.0.0"
PORT=3000
PRISMA_CONNECT_TIMEOUT_MS=10000
SWAGGER_ENABLED=true
# Single origin for host-based local dev — aligns with web's http://127.0.0.1:53173
CORS_ORIGIN="http://127.0.0.1:53173"
WEB_BASE_URL="http://127.0.0.1:53173"
PUBLIC_WEB_BASE_URL="http://127.0.0.1:53173"
PASSWORD_RESET_DEV_LINKS_ENABLED=true
RATE_LIMIT_STORE="memory"
REDIS_URL=""
TRUST_PROXY_HOPS=""
RATE_LIMIT_PREFIX="work-archive:rate-limit:"
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
SYNC_RATE_LIMIT_MAX=30

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="change-me-external-api-key-encryption-secret"
# Production only: required, at least 32 chars, and must not use a change-me/local value.
SECURITY_EVENT_HASH_SECRET="change-me-security-event-hash-secret"

# External search provider API keys are mostly user-scoped encrypted credentials.
# Register user keys in the app settings API Key Vault instead of this env file.
# Optional cost-bearing server search providers are disabled for guests by default.
BRAVE_SEARCH_API_KEY=""
TAVILY_API_KEY=""
IMPORT_SERVER_SEARCH_GUEST_ENABLED=false

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
