# Local host-based API development.
# Copy this file to `apps/api/.env` when you want an explicit local API env file.
# Use `localhost` here because the API process runs on the host in this mode.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/work_archive?schema=public"
HOST="0.0.0.0"
PORT=3000
SWAGGER_ENABLED=true
# Keep this aligned with the frontend origins that reach the API from the browser.
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="change-me-external-api-key-encryption-secret"

# Optional server-scoped import providers for Quick Add.
TMDB_API_READ_TOKEN=""
TMDB_API_KEY=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
KAKAO_REST_API_KEY=""
KOBIS_API_KEY=""

# User-scoped Aladin TTBKey is stored per account through /account/settings.

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
