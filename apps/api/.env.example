# Local host-based API development.
# Copy this file to `apps/api/.env` when you want an explicit local API env file.
# Use the single localhost web origin for both Compose and Vite development.
# Google returns through the web origin and /api proxy.
# For Docker Compose, use root `.env.example` instead.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:18732/work_archive?schema=public&connect_timeout=5"
HOST="0.0.0.0"
PORT=18731
PRISMA_CONNECT_TIMEOUT_MS=10000
SWAGGER_ENABLED=true
# Host-based local dev origin for the Vite server.
CORS_ORIGIN="http://localhost:18730"
WEB_BASE_URL="http://localhost:18730"
PUBLIC_WEB_BASE_URL="http://localhost:18730"
RATE_LIMIT_STORE="memory"
REDIS_URL=""
TRUST_PROXY_HOPS=""
RATE_LIMIT_PREFIX="work-archive:rate-limit:"
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
SYNC_RATE_LIMIT_MAX=30

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Google login stays disabled until both values are set from Google Cloud Console.
# Authorized redirect URI for local API development:
#   http://localhost:18730/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:18730/api/auth/google/callback"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="change-me-external-api-key-encryption-secret"
# Production only: required, at least 32 chars, and must not use a change-me/local value.
SECURITY_EVENT_HASH_SECRET="change-me-security-event-hash-secret"

# External search provider API keys are user-scoped encrypted credentials.
# Register user keys in the app settings API Key Vault instead of this env file.
# Brave Search and Tavily Search do not support operator server keys.
IMPORT_SERVER_SEARCH_GUEST_ENABLED=false

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
