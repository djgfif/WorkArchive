{
  "name": "@work-archive/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch --watch-preserve-output dist/main.js",
    "dev:health": "node scripts/dev-health-watch.mjs",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.mjs --runInBand",
    "test:e2e": "jest --config jest.e2e.config.mjs --runInBand",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "ops:migrate-legacy-genres": "tsx src/operations/migrate-legacy-genres-to-tags.ts",
    "ops:retention:cleanup": "tsx src/operations/retention-cleanup.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^6.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@work-archive/shared-types": "0.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.24",
    "@types/cookie-parser": "^1.4.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@work-archive/eslint-config": "0.1.0",
    "@work-archive/tsconfig": "0.1.0",
    "jest": "^29.7.0",
    "prisma": "^6.6.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4"
  }
}
