generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkType {
  novel
  anime
  manga
  light_novel
  web_novel
  webtoon
  movie
  drama
  other
}

enum WorkStatus {
  planned
  in_progress
  completed
  dropped
}

enum WorkSyncStatus {
  local_only @map("local-only")
  pending
  synced
  conflict
}

enum TierBoardVisibility {
  private
  link_only
  exported
}

enum TierBoardType {
  classic_tier
  ranking
  freeform
}

enum TierBoardCardSourceType {
  custom
  image_upload
  image_url
  library_work
}

enum TierBoardAssetKind {
  image
}

enum TierBoardAssetStorageType {
  local_blob
  remote_url
}

enum ProgressUnit {
  volume
  episode
  chapter
}

enum TimelineEntryType {
  note
  started
  completed
  dropped
  rewatch
  progress
}

enum UserRole {
  user
  moderator
  admin
}

enum CatalogVerificationStatus {
  draft
  pending
  verified
  rejected
  merged
}

enum CatalogTitleStatus {
  unknown
  upcoming
  ongoing
  completed
  hiatus
  cancelled
}

enum ContributorEntityType {
  person
  organization
  group
}

enum CatalogContributorRole {
  author
  illustrator
  director
  studio
  publisher
  screenwriter
  original_creator
  artist
  translator
}

enum CatalogRelationType {
  original
  adaptation
  spin_off
  sequel
  prequel
  side_story
  remake
  compilation
  alternate_version
}

enum SeriesKind {
  series
  franchise
  universe
  arc
  collection
}

enum WorkSeriesRole {
  main
  season
  arc
  movie
  ova
  spin_off
  side_story
}

enum WorkContributorRole {
  author
  illustrator
  director
  studio
  publisher
  screenwriter
  original_creator
  artist
  translator
  platform
  production_company
}

enum WorkRelationType {
  original
  adaptation
  spin_off
  sequel
  prequel
  side_story
  remake
  compilation
  alternate_version
  same_universe
  season_next
  season_previous
}

enum CatalogSubmissionStatus {
  pending
  approved
  rejected
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String?                 @db.Text
  handle                 String?                 @unique
  avatarUrl              String                  @default("") @db.Text
  refreshTokenHash       String?                 @db.Text
  nickname               String                  @default("")
  role                   UserRole                @default(user)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  authAccounts           UserAuthAccount[]
  workRecords            UserWorkRecord[]
  timelineEntries        UserTimelineEntry[]
  externalApiCredentials ExternalApiCredential[]
  passwordResetTokens    PasswordResetToken[]
  refreshSessions        UserRefreshSession[]
  catalogSubmissions     CatalogSubmission[]     @relation("CatalogSubmissionSubmitter")
  reviewedSubmissions    CatalogSubmission[]     @relation("CatalogSubmissionReviewer")
  catalogAuditLogs       CatalogAuditLog[]
  syncAppliedMutations   UserSyncAppliedMutation[]
  series                 UserSeries[]
  contributors           UserContributor[]
  workRelations          UserWorkRelation[]
  tierBoards             UserTierBoard[]

  @@map("users")
}

model UserAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String
  emailVerified     Boolean  @default(false)
  name              String   @default("")
  pictureUrl        String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
  @@map("user_auth_accounts")
}

model UserRefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @db.Text
  rememberMe Boolean   @default(true)
  userAgent  String?   @db.Text
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  rotatedAt  DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @db.Text
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CatalogWork {
  id           String           @id @default(uuid())
  type         WorkType         @default(novel)
  title        String
  author       String           @default("")
  genres       String[]         @default([])
  description  String           @default("") @db.Text
  thumbnailUrl String           @default("")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  userRecords  UserWorkRecord[]

  @@index([type, updatedAt])
  @@index([updatedAt])
  @@map("catalog_works")
}

model Franchise {
  id                 String                    @id @default(uuid())
  canonicalName      String
  displayName        String
  originalName       String?
  aliases            String[]                  @default([])
  description        String                    @default("") @db.Text
  thumbnailUrl       String                    @default("")
  verificationStatus CatalogVerificationStatus @default(draft)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  titles             CatalogTitle[]
  externalRefs       CatalogExternalRef[]

  @@index([verificationStatus, updatedAt])
  @@index([canonicalName])
  @@map("franchises")
}

model CatalogTitle {
  id                 String                    @id @default(uuid())
  franchiseId        String?
  mediumType         WorkType                  @default(other)
  subType            String?
  canonicalTitle     String
  displayTitle       String
  originalTitle      String?
  aliases            String[]                  @default([])
  releaseYear        Int?
  startDate          DateTime?
  endDate            DateTime?
  country            String?
  status             CatalogTitleStatus        @default(unknown)
  summary            String                    @default("") @db.Text
  thumbnailUrl       String                    @default("")
  verificationStatus CatalogVerificationStatus @default(draft)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  franchise          Franchise?                @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  releases           CatalogRelease[]
  contributors       CatalogTitleContributor[]
  outgoingRelations  CatalogRelation[]         @relation("CatalogRelationSource")
  incomingRelations  CatalogRelation[]         @relation("CatalogRelationTarget")
  externalRefs       CatalogExternalRef[]
  userRecords        UserWorkRecord[]

  @@index([franchiseId])
  @@index([mediumType, updatedAt])
  @@index([verificationStatus, updatedAt])
  @@index([canonicalTitle])
  @@map("catalog_titles")
}

model CatalogRelease {
  id                 String               @id @default(uuid())
  catalogTitleId     String
  releaseType        String               @default("")
  displayLabel       String               @default("")
  title              String               @default("")
  sequence           Float?
  isbn               String?
  releaseDate        DateTime?
  summary            String               @default("") @db.Text
  thumbnailUrl       String               @default("")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  catalogTitle       CatalogTitle         @relation(fields: [catalogTitleId], references: [id], onDelete: Cascade)
  externalRefs       CatalogExternalRef[]
  userReleaseRecords UserReleaseRecord[]

  @@index([catalogTitleId, sequence])
  @@index([isbn])
  @@map("catalog_releases")
}

model Contributor {
  id            String                    @id @default(uuid())
  entityType    ContributorEntityType     @default(person)
  canonicalName String
  displayName   String
  aliases       String[]                  @default([])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  titles        CatalogTitleContributor[]
  externalRefs  CatalogExternalRef[]

  @@index([entityType, canonicalName])
  @@map("contributors")
}

model CatalogTitleContributor {
  id             String                 @id @default(uuid())
  catalogTitleId String
  contributorId  String
  role           CatalogContributorRole
  displayOrder   Int                    @default(0)
  catalogTitle   CatalogTitle           @relation(fields: [catalogTitleId], references: [id], onDelete: Cascade)
  contributor    Contributor            @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([catalogTitleId, contributorId, role])
  @@index([contributorId, role])
  @@map("catalog_title_contributors")
}

model CatalogRelation {
  id            String              @id @default(uuid())
  sourceTitleId String
  targetTitleId String
  relationType  CatalogRelationType
  createdAt     DateTime            @default(now())
  sourceTitle   CatalogTitle        @relation("CatalogRelationSource", fields: [sourceTitleId], references: [id], onDelete: Cascade)
  targetTitle   CatalogTitle        @relation("CatalogRelationTarget", fields: [targetTitleId], references: [id], onDelete: Cascade)

  @@unique([sourceTitleId, targetTitleId, relationType])
  @@index([targetTitleId, relationType])
  @@map("catalog_relations")
}

model CatalogExternalRef {
  id               String          @id @default(uuid())
  catalogTitleId   String?
  catalogReleaseId String?
  franchiseId      String?
  contributorId    String?
  provider         String
  externalId       String
  url              String          @default("")
  rawType          String          @default("")
  language         String?
  country          String?
  confidence       Float?
  lastFetchedAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  catalogTitle     CatalogTitle?   @relation(fields: [catalogTitleId], references: [id], onDelete: Cascade)
  catalogRelease   CatalogRelease? @relation(fields: [catalogReleaseId], references: [id], onDelete: Cascade)
  franchise        Franchise?      @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  contributor      Contributor?    @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([provider, rawType, externalId])
  @@index([catalogTitleId])
  @@index([catalogReleaseId])
  @@index([franchiseId])
  @@index([contributorId])
  @@map("catalog_external_refs")
}

model CatalogSubmission {
  id          String                  @id @default(uuid())
  submitterId String
  reviewerId  String?
  status      CatalogSubmissionStatus @default(pending)
  entityType  String
  entityId    String?
  action      String
  payload     Json
  note        String                  @default("") @db.Text
  reviewNote  String                  @default("") @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  submitter   User                    @relation("CatalogSubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewer    User?                   @relation("CatalogSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submitterId, createdAt])
  @@map("catalog_submissions")
}

model CatalogAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("catalog_audit_logs")
}

model SecurityEvent {
  id            String   @id @default(uuid())
  eventType     String
  severity      String
  requestId     String?
  userId        String?
  sessionId     String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
  @@map("security_events")
}

model UserSyncAppliedMutation {
  id               String   @id @default(uuid())
  userId           String
  clientMutationId String
  queueId          String
  entityType       String
  entityId         String
  result           Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientMutationId])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("user_sync_applied_mutations")
}

model UserWorkRecord {
  id                String              @id @default(uuid())
  userId            String?
  catalogWorkId     String
  catalogTitleId    String?
  status            WorkStatus          @default(planned)
  rating            Float?
  shortReview       String              @default("")
  review            String              @default("") @db.Text
  personalTags      String[]            @default([])
  favorite          Boolean             @default(false)
  progressCurrent   Int?
  progressTotal     Int?
  progressUnit      ProgressUnit?
  lastConsumedLabel String?
  startedAt         DateTime?
  completedAt       DateTime?
  droppedAt         DateTime?
  lastConsumedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  syncStatus        WorkSyncStatus      @default(synced)
  serverVersion     Int                 @default(1)
  catalogWork       CatalogWork         @relation(fields: [catalogWorkId], references: [id], onDelete: Cascade)
  catalogTitle      CatalogTitle?       @relation(fields: [catalogTitleId], references: [id], onDelete: SetNull)
  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseRecords    UserReleaseRecord[]
  timelineEntries   UserTimelineEntry[]
  seriesLinks       UserWorkSeriesLink[]
  contributorLinks  UserWorkContributor[]
  outgoingRelations UserWorkRelation[]  @relation("UserWorkRelationSource")
  incomingRelations UserWorkRelation[]  @relation("UserWorkRelationTarget")
  tierBoardCards    UserTierBoardCard[]

  @@index([userId, deletedAt])
  @@index([userId, status, updatedAt])
  @@index([userId, updatedAt])
  @@index([userId, updatedAt, id], map: "user_work_records_userId_updatedAt_id_idx")
  @@index([catalogWorkId])
  @@index([catalogTitleId])
  @@map("user_work_records")
}

model UserTimelineEntry {
  id               String            @id @default(uuid())
  userId           String
  userWorkRecordId String
  type             TimelineEntryType @default(note)
  occurredAt       DateTime
  note             String            @default("") @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  syncStatus       WorkSyncStatus    @default(synced)
  serverVersion    Int               @default(1)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWorkRecord   UserWorkRecord    @relation(fields: [userWorkRecordId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt, id], map: "user_timeline_entries_userId_updatedAt_id_idx")
  @@index([userWorkRecordId, occurredAt])
  @@index([userWorkRecordId, deletedAt])
  @@map("user_timeline_entries")
}

model UserReleaseRecord {
  id               String         @id @default(uuid())
  userWorkRecordId String
  catalogReleaseId String
  status           WorkStatus     @default(planned)
  rating           Float?
  shortReview      String         @default("")
  review           String         @default("") @db.Text
  favorite         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  syncStatus       WorkSyncStatus @default(synced)
  serverVersion    Int            @default(1)
  userWorkRecord   UserWorkRecord @relation(fields: [userWorkRecordId], references: [id], onDelete: Cascade)
  catalogRelease   CatalogRelease @relation(fields: [catalogReleaseId], references: [id], onDelete: Restrict)

  @@unique([userWorkRecordId, catalogReleaseId])
  @@index([userWorkRecordId, deletedAt])
  @@index([userWorkRecordId, updatedAt, id], map: "user_release_records_userWorkRecordId_updatedAt_id_idx")
  @@index([catalogReleaseId])
  @@index([updatedAt])
  @@index([updatedAt, id], map: "user_release_records_updatedAt_id_idx")
  @@map("user_release_records")
}

model UserSeries {
  id              String               @id @default(uuid())
  userId          String
  title           String
  normalizedTitle String
  aliases         String[]             @default([])
  kind            SeriesKind           @default(series)
  parentId        String?
  description     String               @default("") @db.Text
  thumbnailUrl    String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  syncStatus      WorkSyncStatus       @default(synced)
  serverVersion   Int                  @default(1)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          UserSeries?          @relation("UserSeriesParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        UserSeries[]         @relation("UserSeriesParent")
  workLinks       UserWorkSeriesLink[]

  @@unique([userId, kind, normalizedTitle])
  @@index([userId, updatedAt, id])
  @@index([userId, deletedAt])
  @@index([parentId])
  @@map("user_series")
}

model UserWorkSeriesLink {
  id            String         @id @default(uuid())
  userWorkId    String
  userSeriesId  String
  role          WorkSeriesRole @default(main)
  orderIndex    Float?
  orderLabel    String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  syncStatus    WorkSyncStatus @default(synced)
  serverVersion Int            @default(1)
  userWork      UserWorkRecord @relation(fields: [userWorkId], references: [id], onDelete: Cascade)
  userSeries    UserSeries     @relation(fields: [userSeriesId], references: [id], onDelete: Cascade)

  @@unique([userWorkId, userSeriesId, role])
  @@index([userSeriesId, role])
  @@index([updatedAt, id])
  @@map("user_work_series_links")
}

model UserContributor {
  id             String                    @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  aliases        String[]                  @default([])
  entityType     ContributorEntityType     @default(person)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  syncStatus     WorkSyncStatus            @default(synced)
  serverVersion  Int                       @default(1)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLinks      UserWorkContributor[]

  @@unique([userId, entityType, normalizedName])
  @@index([userId, updatedAt, id])
  @@index([userId, deletedAt])
  @@map("user_contributors")
}

model UserWorkContributor {
  id                String              @id @default(uuid())
  userWorkId        String
  userContributorId String
  role              WorkContributorRole
  displayOrder      Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  syncStatus        WorkSyncStatus      @default(synced)
  serverVersion     Int                 @default(1)
  userWork          UserWorkRecord      @relation(fields: [userWorkId], references: [id], onDelete: Cascade)
  userContributor   UserContributor     @relation(fields: [userContributorId], references: [id], onDelete: Cascade)

  @@unique([userWorkId, userContributorId, role])
  @@index([userContributorId, role])
  @@index([updatedAt, id])
  @@map("user_work_contributors")
}

model UserWorkRelation {
  id             String           @id @default(uuid())
  userId         String
  sourceWorkId   String
  targetWorkId   String
  relationType   WorkRelationType
  note           String           @default("") @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  syncStatus     WorkSyncStatus   @default(synced)
  serverVersion  Int              @default(1)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceWork     UserWorkRecord   @relation("UserWorkRelationSource", fields: [sourceWorkId], references: [id], onDelete: Cascade)
  targetWork     UserWorkRecord   @relation("UserWorkRelationTarget", fields: [targetWorkId], references: [id], onDelete: Cascade)

  @@unique([sourceWorkId, targetWorkId, relationType])
  @@index([userId, updatedAt, id])
  @@index([targetWorkId, relationType])
  @@map("user_work_relations")
}

model UserTierBoard {
  id            String              @id @default(uuid())
  userId        String
  slug          String
  title         String
  description   String              @default("") @db.Text
  boardType     TierBoardType        @default(classic_tier)
  visibility    TierBoardVisibility  @default(private)
  coverImageUrl String              @default("") @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  syncStatus    WorkSyncStatus       @default(synced)
  serverVersion Int                 @default(1)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lanes         UserTierLane[]
  cards         UserTierBoardCard[]
  assets        UserTierBoardAsset[]

  @@index([userId, updatedAt, id])
  @@index([userId, deletedAt])
  @@unique([userId, slug])
  @@map("user_tier_boards")
}

model UserTierLane {
  id            String          @id @default(uuid())
  boardId       String
  title         String
  description   String          @default("") @db.Text
  colorToken    String          @default("#64748b")
  orderIndex    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  syncStatus    WorkSyncStatus   @default(synced)
  serverVersion Int             @default(1)
  board         UserTierBoard    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards         UserTierBoardCard[]

  @@index([boardId, orderIndex])
  @@index([updatedAt, id])
  @@map("user_tier_lanes")
}

model UserTierBoardCard {
  id             String                  @id @default(uuid())
  boardId        String
  laneId         String?
  orderIndex     Int                     @default(0)
  cardSourceType TierBoardCardSourceType @default(custom)
  userWorkId     String?
  title          String
  subtitle       String                  @default("")
  imageUrl       String                  @default("") @db.Text
  note           String                  @default("") @db.Text
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  syncStatus     WorkSyncStatus          @default(synced)
  serverVersion  Int                     @default(1)
  board          UserTierBoard           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  lane           UserTierLane?           @relation(fields: [laneId], references: [id], onDelete: SetNull)
  linkedWork     UserWorkRecord?         @relation(fields: [userWorkId], references: [id], onDelete: SetNull)
  assets         UserTierBoardAsset[]

  @@index([boardId, laneId, orderIndex])
  @@index([boardId, deletedAt])
  @@index([userWorkId, deletedAt])
  @@index([updatedAt, id])
  @@map("user_tier_board_cards")
}

model UserTierBoardAsset {
  id          String                    @id @default(uuid())
  boardId     String
  cardId      String?
  kind        TierBoardAssetKind        @default(image)
  storageType TierBoardAssetStorageType
  objectUrl   String                    @db.Text
  originalName String                   @default("")
  mimeType    String                    @default("")
  sizeBytes   Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  deletedAt   DateTime?
  board       UserTierBoard             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card        UserTierBoardCard?        @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([boardId, deletedAt])
  @@index([cardId, deletedAt])
  @@index([updatedAt, id])
  @@map("user_tier_board_assets")
}

model ExternalApiCredential {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  encryptedKey String   @db.Text
  iv           String   @db.Text
  authTag      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider])
  @@map("external_api_credentials")
}
