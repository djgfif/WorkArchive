generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkType {
  novel
  anime
  manga
  light_novel
  web_novel
  webtoon
  movie
  drama
  other
}

enum WorkStatus {
  planned
  in_progress
  completed
  paused
  dropped
}

enum WorkTier {
  S
  A
  B
  C
  D
}

enum WorkSyncStatus {
  local_only @map("local-only")
  pending
  synced
  conflict
}

model Work {
  id           String      @id @default(uuid())
  userId       String?
  type         WorkType    @default(novel)
  title        String
  author       String      @default("")
  genres       String[]    @default([])
  description  String      @default("") @db.Text
  thumbnailUrl String      @default("")
  status       WorkStatus  @default(planned)
  rating       Float?
  shortReview  String      @default("")
  review       String      @default("") @db.Text
  tier         WorkTier?
  favorite     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  syncStatus    WorkSyncStatus @default(synced)
  serverVersion Int        @default(1)
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([userId, type, updatedAt])
  @@index([userId, status, updatedAt])
  @@index([userId, updatedAt])
  @@map("works")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @db.Text
  refreshTokenHash String?  @db.Text
  nickname         String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  works            Work[]

  @@map("users")
}
