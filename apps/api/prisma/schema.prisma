generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkType {
  novel
  anime
  manga
  light_novel
  web_novel
  webtoon
  movie
  drama
  other
}

enum WorkStatus {
  planned
  in_progress
  completed
  paused
  dropped
}

enum WorkTier {
  S
  A
  B
  C
  D
}

enum WorkSyncStatus {
  local_only @map("local-only")
  pending
  synced
  conflict
}

enum ProgressUnit {
  volume
  episode
  chapter
}

enum TimelineEntryType {
  note
  started
  completed
  dropped
  rewatch
  progress
}

enum UserRole {
  user
  moderator
  admin
}

enum CatalogVerificationStatus {
  draft
  pending
  verified
  rejected
  merged
}

enum CatalogTitleStatus {
  unknown
  upcoming
  ongoing
  completed
  hiatus
  cancelled
}

enum ContributorEntityType {
  person
  organization
  group
}

enum CatalogContributorRole {
  author
  illustrator
  director
  studio
  publisher
  screenwriter
  original_creator
  artist
  translator
}

enum CatalogRelationType {
  original
  adaptation
  spin_off
  sequel
  prequel
  side_story
  remake
  compilation
  alternate_version
}

enum CatalogSubmissionStatus {
  pending
  approved
  rejected
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String                  @db.Text
  refreshTokenHash       String?                 @db.Text
  nickname               String                  @default("")
  role                   UserRole                @default(user)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workRecords            UserWorkRecord[]
  timelineEntries        UserTimelineEntry[]
  externalApiCredentials ExternalApiCredential[]
  passwordResetTokens    PasswordResetToken[]
  refreshSessions        UserRefreshSession[]
  catalogSubmissions     CatalogSubmission[]     @relation("CatalogSubmissionSubmitter")
  reviewedSubmissions    CatalogSubmission[]     @relation("CatalogSubmissionReviewer")
  catalogAuditLogs       CatalogAuditLog[]

  @@map("users")
}

model UserRefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @db.Text
  rememberMe Boolean   @default(true)
  userAgent  String?   @db.Text
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  rotatedAt  DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @db.Text
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CatalogWork {
  id           String           @id @default(uuid())
  type         WorkType         @default(novel)
  title        String
  author       String           @default("")
  genres       String[]         @default([])
  description  String           @default("") @db.Text
  thumbnailUrl String           @default("")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  userRecords  UserWorkRecord[]

  @@index([type, updatedAt])
  @@index([updatedAt])
  @@map("catalog_works")
}

model Franchise {
  id                 String                    @id @default(uuid())
  canonicalName      String
  displayName        String
  originalName       String?
  aliases            String[]                  @default([])
  description        String                    @default("") @db.Text
  thumbnailUrl       String                    @default("")
  verificationStatus CatalogVerificationStatus @default(draft)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  titles             CatalogTitle[]
  externalRefs       CatalogExternalRef[]

  @@index([verificationStatus, updatedAt])
  @@index([canonicalName])
  @@map("franchises")
}

model CatalogTitle {
  id                 String                    @id @default(uuid())
  franchiseId        String?
  mediumType         WorkType                  @default(other)
  subType            String?
  canonicalTitle     String
  displayTitle       String
  originalTitle      String?
  aliases            String[]                  @default([])
  releaseYear        Int?
  startDate          DateTime?
  endDate            DateTime?
  country            String?
  status             CatalogTitleStatus        @default(unknown)
  summary            String                    @default("") @db.Text
  thumbnailUrl       String                    @default("")
  verificationStatus CatalogVerificationStatus @default(draft)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  franchise          Franchise?                @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  releases           CatalogRelease[]
  contributors       CatalogTitleContributor[]
  outgoingRelations  CatalogRelation[]         @relation("CatalogRelationSource")
  incomingRelations  CatalogRelation[]         @relation("CatalogRelationTarget")
  externalRefs       CatalogExternalRef[]
  userRecords        UserWorkRecord[]

  @@index([franchiseId])
  @@index([mediumType, updatedAt])
  @@index([verificationStatus, updatedAt])
  @@index([canonicalTitle])
  @@map("catalog_titles")
}

model CatalogRelease {
  id                 String               @id @default(uuid())
  catalogTitleId     String
  releaseType        String               @default("")
  displayLabel       String               @default("")
  title              String               @default("")
  sequence           Float?
  isbn               String?
  releaseDate        DateTime?
  summary            String               @default("") @db.Text
  thumbnailUrl       String               @default("")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  catalogTitle       CatalogTitle         @relation(fields: [catalogTitleId], references: [id], onDelete: Cascade)
  externalRefs       CatalogExternalRef[]
  userReleaseRecords UserReleaseRecord[]

  @@index([catalogTitleId, sequence])
  @@index([isbn])
  @@map("catalog_releases")
}

model Contributor {
  id            String                    @id @default(uuid())
  entityType    ContributorEntityType     @default(person)
  canonicalName String
  displayName   String
  aliases       String[]                  @default([])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  titles        CatalogTitleContributor[]
  externalRefs  CatalogExternalRef[]

  @@index([entityType, canonicalName])
  @@map("contributors")
}

model CatalogTitleContributor {
  id             String                 @id @default(uuid())
  catalogTitleId String
  contributorId  String
  role           CatalogContributorRole
  displayOrder   Int                    @default(0)
  catalogTitle   CatalogTitle           @relation(fields: [catalogTitleId], references: [id], onDelete: Cascade)
  contributor    Contributor            @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([catalogTitleId, contributorId, role])
  @@index([contributorId, role])
  @@map("catalog_title_contributors")
}

model CatalogRelation {
  id            String              @id @default(uuid())
  sourceTitleId String
  targetTitleId String
  relationType  CatalogRelationType
  createdAt     DateTime            @default(now())
  sourceTitle   CatalogTitle        @relation("CatalogRelationSource", fields: [sourceTitleId], references: [id], onDelete: Cascade)
  targetTitle   CatalogTitle        @relation("CatalogRelationTarget", fields: [targetTitleId], references: [id], onDelete: Cascade)

  @@unique([sourceTitleId, targetTitleId, relationType])
  @@index([targetTitleId, relationType])
  @@map("catalog_relations")
}

model CatalogExternalRef {
  id               String          @id @default(uuid())
  catalogTitleId   String?
  catalogReleaseId String?
  franchiseId      String?
  contributorId    String?
  provider         String
  externalId       String
  url              String          @default("")
  rawType          String          @default("")
  language         String?
  country          String?
  confidence       Float?
  lastFetchedAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  catalogTitle     CatalogTitle?   @relation(fields: [catalogTitleId], references: [id], onDelete: Cascade)
  catalogRelease   CatalogRelease? @relation(fields: [catalogReleaseId], references: [id], onDelete: Cascade)
  franchise        Franchise?      @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  contributor      Contributor?    @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([provider, rawType, externalId])
  @@index([catalogTitleId])
  @@index([catalogReleaseId])
  @@index([franchiseId])
  @@index([contributorId])
  @@map("catalog_external_refs")
}

model CatalogSubmission {
  id          String                  @id @default(uuid())
  submitterId String
  reviewerId  String?
  status      CatalogSubmissionStatus @default(pending)
  entityType  String
  entityId    String?
  action      String
  payload     Json
  note        String                  @default("") @db.Text
  reviewNote  String                  @default("") @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  submitter   User                    @relation("CatalogSubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewer    User?                   @relation("CatalogSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submitterId, createdAt])
  @@map("catalog_submissions")
}

model CatalogAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("catalog_audit_logs")
}

model SecurityEvent {
  id            String   @id @default(uuid())
  eventType     String
  severity      String
  requestId     String?
  userId        String?
  sessionId     String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
  @@map("security_events")
}

model UserWorkRecord {
  id                String              @id @default(uuid())
  userId            String?
  catalogWorkId     String
  catalogTitleId    String?
  status            WorkStatus          @default(planned)
  rating            Float?
  shortReview       String              @default("")
  review            String              @default("") @db.Text
  personalTags      String[]            @default([])
  tier              WorkTier?
  favorite          Boolean             @default(false)
  progressCurrent   Int?
  progressTotal     Int?
  progressUnit      ProgressUnit?
  lastConsumedLabel String?
  startedAt         DateTime?
  completedAt       DateTime?
  droppedAt         DateTime?
  lastConsumedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  syncStatus        WorkSyncStatus      @default(synced)
  serverVersion     Int                 @default(1)
  catalogWork       CatalogWork         @relation(fields: [catalogWorkId], references: [id], onDelete: Cascade)
  catalogTitle      CatalogTitle?       @relation(fields: [catalogTitleId], references: [id], onDelete: SetNull)
  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseRecords    UserReleaseRecord[]
  timelineEntries   UserTimelineEntry[]

  @@index([userId, deletedAt])
  @@index([userId, status, updatedAt])
  @@index([userId, updatedAt])
  @@index([userId, updatedAt, id], map: "user_work_records_userId_updatedAt_id_idx")
  @@index([catalogWorkId])
  @@index([catalogTitleId])
  @@map("user_work_records")
}

model UserTimelineEntry {
  id               String            @id @default(uuid())
  userId           String
  userWorkRecordId String
  type             TimelineEntryType @default(note)
  occurredAt       DateTime
  note             String            @default("") @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  syncStatus       WorkSyncStatus    @default(synced)
  serverVersion    Int               @default(1)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWorkRecord   UserWorkRecord    @relation(fields: [userWorkRecordId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt, id], map: "user_timeline_entries_userId_updatedAt_id_idx")
  @@index([userWorkRecordId, occurredAt])
  @@index([userWorkRecordId, deletedAt])
  @@map("user_timeline_entries")
}

model UserReleaseRecord {
  id               String         @id @default(uuid())
  userWorkRecordId String
  catalogReleaseId String
  status           WorkStatus     @default(planned)
  rating           Float?
  shortReview      String         @default("")
  review           String         @default("") @db.Text
  favorite         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  syncStatus       WorkSyncStatus @default(synced)
  serverVersion    Int            @default(1)
  userWorkRecord   UserWorkRecord @relation(fields: [userWorkRecordId], references: [id], onDelete: Cascade)
  catalogRelease   CatalogRelease @relation(fields: [catalogReleaseId], references: [id], onDelete: Restrict)

  @@unique([userWorkRecordId, catalogReleaseId])
  @@index([userWorkRecordId, deletedAt])
  @@index([userWorkRecordId, updatedAt, id], map: "user_release_records_userWorkRecordId_updatedAt_id_idx")
  @@index([catalogReleaseId])
  @@index([updatedAt])
  @@index([updatedAt, id], map: "user_release_records_updatedAt_id_idx")
  @@map("user_release_records")
}

model ExternalApiCredential {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  encryptedKey String   @db.Text
  iv           String   @db.Text
  authTag      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider])
  @@map("external_api_credentials")
}
