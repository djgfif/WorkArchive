# Production compose environment template.
# Copy to `.env.prod` on the deployment host and replace every placeholder.
# Do not commit `.env.prod` or paste real secret values into reports.

POSTGRES_DB=work_archive
POSTGRES_USER=work_archive
POSTGRES_PASSWORD=<generate-with-openssl-rand-base64-32>
DATABASE_URL=postgresql://work_archive:<same-postgres-password>@postgres:5432/work_archive?schema=public

HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
WEB_PORT=8080
CORS_ORIGIN=https://archive.example.com
WEB_BASE_URL=https://archive.example.com
VITE_API_BASE_URL=/api
PASSWORD_RESET_DEV_LINKS_ENABLED=false

# Runtime web feature flags are loaded from `/work-archive-config.js` before
# the React bundle. Keep this env file secret-free for client behavior.
# Example production override file content:
# window.__WORK_ARCHIVE_CONFIG__ = { featureFlags: { tierBoards: false } };

RATE_LIMIT_STORE=redis
REDIS_URL=redis://redis:6379
TRUST_PROXY_HOPS=1
RATE_LIMIT_PREFIX=work-archive:rate-limit:
API_GLOBAL_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=120
AUTH_SENSITIVE_RATE_LIMIT_MAX=20
CATALOG_RATE_LIMIT_MAX=20
IMPORT_AUTH_RATE_LIMIT_MAX=60
IMPORT_GUEST_RATE_LIMIT_MAX=20
IMAGE_PROXY_RATE_LIMIT_MAX=120
MUTATION_RATE_LIMIT_MAX=120
NOTION_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
SYNC_RATE_LIMIT_MAX=120
READINESS_CHECK_TIMEOUT_MS=1500
API_REQUEST_TIMEOUT_MS=120000
API_HEADERS_TIMEOUT_MS=15000
API_KEEP_ALIVE_TIMEOUT_MS=5000
API_JSON_BODY_LIMIT=2mb
API_URLENCODED_BODY_LIMIT=64kb
COOKIE_SECURE=true
SWAGGER_ENABLED=false
WORK_ARCHIVE_CLIENT_HEADER_GUARD=audit

# Keep disabled unless /metrics is reachable only by an internal collector or
# reverse-proxy allowlist.
METRICS_ENABLED=false
METRICS_INTERNAL_ACCESS_REVIEWED=false
METRICS_BEARER_TOKEN=<set-when-metrics-enabled>

JWT_ACCESS_SECRET=<generate-unique-48-byte-secret>
JWT_REFRESH_SECRET=<generate-unique-48-byte-secret>
EXTERNAL_API_KEY_ENCRYPTION_SECRET=<generate-unique-48-byte-secret>
SECURITY_EVENT_HASH_SECRET=<generate-unique-48-byte-secret>

GOOGLE_OAUTH_CLIENT_ID=<google-oauth-web-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-web-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://archive.example.com/api/auth/google/callback

# Optional server-scoped import provider keys.
# Leave blank unless the deployment intentionally enables server-side provider search.
TMDB_API_READ_TOKEN=
TMDB_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KOBIS_API_KEY=
KOBIS_HTTP_PROVIDER_ENABLED=false
IMPORT_SERVER_SEARCH_GUEST_ENABLED=false
IMPORT_SERVER_SEARCH_GUEST_APPROVED=false
