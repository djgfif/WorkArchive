# Host/Vite local development.
# Copy this file to `.env.host` before running `./start-dev.sh host`.

POSTGRES_DB="work_archive"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

POSTGRES_PORT=18732

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:18732/work_archive?schema=public&connect_timeout=5"
HOST="0.0.0.0"
PORT=18731
PRISMA_CONNECT_TIMEOUT_MS=10000
SWAGGER_ENABLED=true
CORS_ORIGIN="http://localhost:18730"
WEB_BASE_URL="http://localhost:18730"
PUBLIC_WEB_BASE_URL="http://localhost:18730"
VITE_API_BASE_URL="/api"

RATE_LIMIT_STORE="memory"
REDIS_URL=""
TRUST_PROXY_HOPS=""
RATE_LIMIT_PREFIX="work-archive:rate-limit:"
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
SYNC_RATE_LIMIT_MAX=30

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="change-me-external-api-key-encryption-secret"
SECURITY_EVENT_HASH_SECRET="change-me-security-event-hash-secret"

# Google login stays disabled until both values are set from Google Cloud Console.
# Google itself returns through the web origin and /api proxy.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:18730/api/auth/google/callback"

IMPORT_SERVER_SEARCH_GUEST_ENABLED=false

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
