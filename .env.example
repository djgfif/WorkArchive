# Root Docker Compose configuration.
# Copy this file to `.env` before running `docker compose up --build`.
# This file is for containerized startup only. Local host-based API dev uses `apps/api/.env`.

POSTGRES_DB="work_archive"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/work_archive?schema=public"
HOST="0.0.0.0"
API_PORT=3000
WEB_PORT=8080
CORS_ORIGIN="http://localhost:8080"
# If API_PORT changes, update VITE_API_BASE_URL.
# If WEB_PORT changes, update CORS_ORIGIN.
VITE_API_BASE_URL="http://localhost:3000/api"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="change-me-external-api-key-encryption-secret"

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
