# Root Docker Compose configuration.
# Copy this file to `.env` before running `docker compose up --build`.
# This file is for containerized startup only.
# 
# For local host-based development, use:
#   - `apps/api/.env` (copy from `apps/api/.env.example`)
#   - `apps/web/.env` (copy from `apps/web/.env.example`)
#   - Run `npm run dev` from root to start both API and web locally.
# The host-based dev uses http://127.0.0.1:53173 for web.

POSTGRES_DB="work_archive"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/work_archive?schema=public"
HOST="0.0.0.0"
API_PORT=3000
WEB_PORT=8080
SWAGGER_ENABLED=true
CORS_ORIGIN="http://localhost:8080"
WEB_BASE_URL="http://localhost:8080"
PASSWORD_RESET_DEV_LINKS_ENABLED=true
RATE_LIMIT_STORE="memory"
# Production compose defaults to Redis-backed rate limiting.
# Use compose.prod.yml with RATE_LIMIT_STORE="redis", REDIS_URL="redis://redis:6379",
# and TRUST_PROXY_HOPS=1 behind the web reverse proxy.
REDIS_URL=""
TRUST_PROXY_HOPS=""
RATE_LIMIT_PREFIX="work-archive:rate-limit:"
# If API_PORT changes, update VITE_API_BASE_URL.
# If WEB_PORT changes, update CORS_ORIGIN.
VITE_API_BASE_URL="http://localhost:3000/api"

JWT_ACCESS_SECRET="local-compose-access-secret-minimum-32-chars"
JWT_REFRESH_SECRET="local-compose-refresh-secret-minimum-32-chars"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="local-compose-external-api-key-secret-32-chars"
# Production only: required for HMAC hashing security audit IP/user-agent data.
SECURITY_EVENT_HASH_SECRET="local-compose-security-event-secret-32-chars"

# Optional server-scoped import providers for Quick Add.
TMDB_API_READ_TOKEN=""
TMDB_API_KEY=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
KAKAO_REST_API_KEY=""
KOBIS_API_KEY=""
BRAVE_SEARCH_API_KEY=""
TAVILY_API_KEY=""
IMPORT_SERVER_SEARCH_GUEST_ENABLED=false

# User-scoped Aladin TTBKey is stored per account through /account/settings.

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
