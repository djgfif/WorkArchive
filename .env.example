# Root Docker Compose configuration.
# Copy this file to `.env` before running `docker compose up --build`.
# This file is for containerized startup only.
# 
# For local host-based development, use:
#   - `apps/api/.env` (copy from `apps/api/.env.example`)
#   - `apps/web/.env` (copy from `apps/web/.env.example`)
#   - Run `npm run dev` from root to start both API and web locally.
# The host-based dev uses http://127.0.0.1:53173 for web.

POSTGRES_DB="work_archive"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/work_archive?schema=public"
HOST="0.0.0.0"
API_PORT=3000
WEB_PORT=8080
CORS_ORIGIN="http://localhost:8080"
WEB_BASE_URL="http://localhost:8080"
PASSWORD_RESET_DEV_LINKS_ENABLED=true
# If API_PORT changes, update VITE_API_BASE_URL.
# If WEB_PORT changes, update CORS_ORIGIN.
VITE_API_BASE_URL="http://localhost:3000/api"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
EXTERNAL_API_KEY_ENCRYPTION_SECRET="change-me-external-api-key-encryption-secret"

# Optional server-scoped import providers for Quick Add.
TMDB_API_READ_TOKEN=""
TMDB_API_KEY=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
KAKAO_REST_API_KEY=""
KOBIS_API_KEY=""

# User-scoped Aladin TTBKey is stored per account through /account/settings.

SEED_DEMO_EMAIL="demo@workarchive.local"
SEED_DEMO_PASSWORD="demo-password-123"
